# Copy to .env and adjust. Docker Compose and `npm run dev` both read this file.

# Database password. Use letters and digits only: it is embedded in a connection URL.
POSTGRES_PASSWORD=change-me

# Defines "today" for budgets, due dates and the daily digest.
APP_TZ=America/New_York
CURRENCY=USD

# When set (16+ characters), the API and dashboard require this token.
# Set it before exposing the app beyond your own machine.
API_TOKEN=

# Daily automation schedule (cron, evaluated in APP_TZ). Default: 6:00 every morning.
DAILY_CRON=0 6 * * *

# Optional Slack or Discord incoming webhook that receives the daily digest.
DIGEST_WEBHOOK_URL=

# Host port for the dashboard.
WEB_PORT=8080

# Used only by `npm run dev` (outside Docker). Match the password above.
DATABASE_URL=postgres://pulse:change-me@localhost:5432/pulse
